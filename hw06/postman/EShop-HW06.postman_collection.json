					"name": "PB-38 & PB-39 - GET cart, verify array shape + round-trip integrity",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"PB-38: GET /api/cart response is a JSON array\", function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json()).to.be.an(\"array\");",
									"});",
									"pm.test(\"PB-39: round-trip integrity - the PB-01 item comes back byte-identical\", function () {",
									"    const body = pm.response.json();",
									"    const found = body.find(function (x) {",
									"        return x && typeof x === \"object\" && x.id === 1 && x.name === \"iPhone 15 Pro Max\";",
									"    });",
									"    pm.expect(found).to.deep.equal({ id: 1, name: \"iPhone 15 Pro Max\", price: 30000000, quantity: 1 });",

# Portable JDK + JMeter (downloaded, not vendored — see tools/env.sh)
tools/jdk-*/
tools/apache-jmeter-*/

# SUT dependencies / local runtime artifacts
eshop-sut/**/node_modules/
eshop-sut/backend/database.sqlite
eshop-sut/**/.env

# JMeter run artifacts (test plans and CSVs ARE tracked; raw results go under results/ deliberately)
jmeter.log
*.jmeter.log
